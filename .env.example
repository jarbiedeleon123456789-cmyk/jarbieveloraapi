# Copy this file to .env and update the values below
# (never commit the real .env — it is git-ignored)

# Application Settings
APP_NAME=Velora
APP_KEY=
APP_ENV=development

# Database Configuration (Aiven MySQL)
DB_DRIVER=mysql
DB_HOST=mysql-13c6ca0d-apathyoferos-3f8e.b.aivencloud.com
DB_PORT=24262
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=
# Aiven requires TLS. Paste the CA certificate text into DB_SSL_CA_PEM
# (use \n for line breaks) or point DB_SSL_CA at a downloaded ca.pem file.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_PEM=

# For API (generate each with: php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URL allowed to call this API (comma-separated, or * for any)
ALLOW_ORIGIN=*

# Migrations: true locally while running `php lava migration run`, false on Render
MIGRATION_ENABLED=false

# Optional: demo admin created by the seed migration
ADMIN_EMAIL=admin@velora.com
ADMIN_PASSWORD=Admin@12345
